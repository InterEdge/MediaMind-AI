[32m+[m
[32m+[m[32mCREATE INDEX IF NOT EXISTS idx_documents_title_trgm[m
[32m+[m[32m  ON documents USING gin (title gin_trgm_ops);[m
[32m+[m
[32m+[m[32mCREATE INDEX IF NOT EXISTS idx_documents_category[m
